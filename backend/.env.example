# Server Port
PORT=5000
NODE_ENV=development

# Database Connection
# During local development, leave this blank to automatically run a persistent local in-process MongoDB instance.
# In production, set this to your MongoDB connection string (e.g. MongoDB Atlas).
MONGODB_URI=

# Session Secret (Cookie Signing)
SESSION_SECRET=hasanaa-secret-key-2024

# Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=hasanaa2024

# CORS Settings (Comma-separated URLs in production, e.g., your Vercel URL)
ALLOWED_ORIGINS=http://localhost:5173

# Image Upload & Storage Provider
# Values: 'local' (development default) or 'cloudinary' (production)
STORAGE_PROVIDER=local

# Cloudinary Credentials (required only if STORAGE_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
