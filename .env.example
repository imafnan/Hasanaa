# ==============================================================================
# HASANAA E-COMMERCE HUB - ENVIRONMENT VARIABLES
# ==============================================================================

# ------------------------------------------------------------------------------
# BACKEND (api-server)
# ------------------------------------------------------------------------------
# The port the backend server listens on
PORT=5000
NODE_ENV=development

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hasanaa

# Session encryption secret (use a secure random string in production)
SESSION_SECRET=hasanaa-secret-key-2024

# Initial admin dashboard login credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=hasanaa2024

# Allowed CORS origins in production (comma-separated). Set to Vercel URL in prod.
ALLOWED_ORIGINS=http://localhost:5173,https://hasanaa-store.vercel.app

# Optional Google Cloud Storage settings (if left blank, fallbacks to local storage)
# PRIVATE_OBJECT_DIR=
# GCP_PROJECT_ID=
# GCP_CLIENT_EMAIL=
# GCP_PRIVATE_KEY=

# ------------------------------------------------------------------------------
# FRONTEND (hasanaa storefront & admin panel)
# ------------------------------------------------------------------------------
# Backend API URL (leave blank when using Vercel rewrites, or set to Render URL)
VITE_API_URL=
# Frontend server configuration (dev)
PORT=5173
BASE_PATH=/
