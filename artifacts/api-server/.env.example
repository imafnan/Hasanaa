# Server Port
PORT=5000
NODE_ENV=development

# Database URL (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hasanaa

# Session Secret (Cookie Signing)
SESSION_SECRET=hasanaa-secret-key-2024

# Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=hasanaa2024

# CORS Settings (Comma-separated URLs in production, e.g., your Vercel URL)
ALLOWED_ORIGINS=http://localhost:5173,https://hasanaa-store.vercel.app

# Google Cloud Storage (Optional - fallback to local disk if blank)
# PRIVATE_OBJECT_DIR=
# GCP_PROJECT_ID=
# GCP_CLIENT_EMAIL=
