{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://hasanaa-backend.onrender.com/api/:path*"
    },
    {
      "source": "/admin/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/category/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/subcategory/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/product/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/cart",
      "destination": "/index.html"
    },
    {
      "source": "/checkout",
      "destination": "/index.html"
    },
    {
      "source": "/order-success",
      "destination": "/index.html"
    }
  ]
}
